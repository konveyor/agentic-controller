# Prototype image. Pass the pinned runtime checkout as the `lightspeed` context.
# Build with hack/lightspeed-runtime/build-image.sh; no Goose compilation needed.
FROM golang:1.26 AS harness-builder
WORKDIR /src/harness
COPY api/go.mod api/go.sum /src/api/
COPY harness/go.mod harness/go.sum ./
RUN go mod download
COPY api/ /src/api/
COPY harness/ ./
RUN CGO_ENABLED=0 go build -o /migration-harness ./cmd/migration-harness

FROM python:3.12-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
    git ca-certificates bash && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir uv==0.8.11
WORKDIR /opt/lightspeed
COPY --from=lightspeed pyproject.toml uv.lock README.md ./
COPY --from=lightspeed src/ ./src/
RUN uv sync --frozen --no-dev --extra openai --extra acp
COPY --from=harness-builder /migration-harness /usr/local/bin/migration-harness
ENV PATH="/opt/lightspeed/.venv/bin:${PATH}" \
    HARNESS_RUNTIME=lightspeed \
    HARNESS_WORK_DIR=/workspace/repo \
    HOME=/home/harness
RUN mkdir -p /opt/skills /workspace /home/harness \
    && useradd -u 1001 -g 0 -d /home/harness -s /usr/sbin/nologin harness \
    && chown -R 1001:0 /workspace /home/harness \
    && chmod -R g=u /workspace /home/harness
WORKDIR /workspace
USER 1001
ENTRYPOINT ["migration-harness"]
CMD ["run"]
