# agent-base: Foundation image with goose CLI, git, and the migration
# harness binary. All language images extend this.
#
# Build context must be the repository root:
#   podman build -t agent-base -f images/agent-base/Containerfile .
#
# Compiling goose takes ~35 minutes, which is nearly all of any build of
# this image. The compile is therefore reachable on its own, as the
# goose-dist target, and the stage that consumes it is an overridable ARG,
# so CI can build the binary once and hand it back in:
#
#   podman build --target goose-dist -t goose:v1.45.0 -f images/agent-base/Containerfile .
#   podman build --build-arg GOOSE_IMAGE=goose:v1.45.0 -f images/agent-base/Containerfile .
#
# With GOOSE_IMAGE set, the goose-builder and goose-dist stages are
# unreferenced and the builder skips them. Left unset it defaults to
# goose-dist, so a plain build still compiles goose from source and no
# caller outside CI has to know any of this. Everything the binary depends
# on lives between this ARG and the goose stage below, and that region is
# what .github/actions/goose-image hashes for its cache key -- keep it that
# way, or a stale binary survives a real change.
ARG GOOSE_IMAGE=goose-dist

# --- Goose build stage ---
FROM golang:1.26 AS goose-builder

# Goose CLI build deps
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y \
    && apt-get update && apt-get install -y \
        build-essential \
        git \
        cmake \
        pkg-config \
        libssl-dev \
        libclang-dev \
        clang \
        libdbus-1-dev \
        libxcb1-dev \
        perl \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/root/.cargo/bin:${PATH}"

# Build goose from source (BUILDING_LINUX.md)
ARG GOOSE_VERSION=v1.45.0
WORKDIR /src/goose
RUN git clone https://github.com/aaif-goose/goose.git . \
    && git checkout ${GOOSE_VERSION} \
    && cargo build --release -p goose-cli --bin goose \
    && mv target/release/goose /usr/local/bin/goose

# Just the binary, so what CI caches and reloads is ~100MB rather than the
# whole Rust toolchain the compile needed.
FROM scratch AS goose-dist
COPY --from=goose-builder /usr/local/bin/goose /usr/local/bin/goose

FROM ${GOOSE_IMAGE} AS goose

# --- Build stage ---
FROM golang:1.26 AS builder

# The harness replaces github.com/konveyor/agentic-controller/api with ../api,
# so that module has to be in the image at the path the replace names, laid out
# the same way it is in the repository. Manifests first, so the download layer
# still caches on go.mod alone.
WORKDIR /src/harness
COPY api/go.mod api/go.sum /src/api/
COPY harness/go.mod harness/go.sum ./
RUN go mod download
COPY api/ /src/api/
COPY harness/cmd/ cmd/
COPY harness/internal/ internal/
RUN CGO_ENABLED=0 go build -o /migration-harness ./cmd/migration-harness/

# --- Runtime stage ---
FROM registry.access.redhat.com/ubi10/ubi:latest

RUN dnf install -y \
    git \
    ca-certificates \
    bzip2 \
    tar \
    && dnf clean all

# Copy goose binary from the goose stage
COPY --from=goose /usr/local/bin/goose /usr/local/bin/goose

ENV PATH="/opt/migration-harness/bin:${PATH}"
ENV HARNESS_WORK_DIR=/workspace/repo
# OpenShift runs containers as a random UID with no passwd entry, which
# leaves HOME=/ — goose then panics creating /.local/... (state, session
# DBs). Pin HOME to the harness home, which is group-0 writable (g=u).
ENV HOME=/home/harness

COPY --from=builder /migration-harness /opt/migration-harness/bin/migration-harness

RUN mkdir -p /opt/skills /workspace /home/harness/.migration-harness \
    && useradd -u 1001 -g 0 -d /home/harness -s /sbin/nologin harness \
    && chown -R 1001:0 /home/harness /workspace \
    && chmod -R g=u /home/harness /workspace

ENV HOME=/home/harness
WORKDIR /workspace
USER 1001

ENTRYPOINT ["migration-harness"]
CMD ["run"]
