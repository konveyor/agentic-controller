# agent-base: UBI foundation with Lightspeed runtime, git, and the migration
# harness. All language images extend this. Build context is the repository root.

# --- Build stage ---
# Red Hat go-toolset (not upstream golang) is required for FIPS: built with
# CGO_ENABLED=1 + GOEXPERIMENT=strictfipsruntime, the Go crypto routes through
# the system OpenSSL (a FIPS-validated module) instead of Go's built-in crypto.
FROM registry.access.redhat.com/ubi9/go-toolset:1.26 AS builder
# go-toolset defaults to UID 1001; the build writes under /src.
USER 0

# The harness replaces github.com/konveyor/agentic-controller/api with ../api,
# so that module has to be in the image at the path the replace names, laid out
# the same way it is in the repository. Manifests first, so the download layer
# still caches on go.mod alone.
WORKDIR /src/harness
COPY api/go.mod api/go.sum /src/api/
COPY harness/go.mod harness/go.sum ./
RUN go mod download
COPY api/ /src/api/
COPY harness/cmd/ cmd/
COPY harness/internal/ internal/
RUN CGO_ENABLED=1 GOEXPERIMENT=strictfipsruntime go build -tags strictfipsruntime -o /migration-harness ./cmd/migration-harness/

# --- Runtime stage ---
FROM registry.access.redhat.com/ubi10/ubi:latest

RUN dnf install -y \
    git \
    python3 \
    python3-pip \
    ca-certificates \
    bzip2 \
    tar \
    && dnf clean all

# Source and dependency pins are shared by local, PR, and release builds.
# Git is also required by the frozen deepagents-acp dependency during uv sync.
ARG LIGHTSPEED_REPOSITORY=https://github.com/djzager/lightspeed-agentic-sandbox.git
ARG LIGHTSPEED_REVISION=2291ce9e449976d080dd1a287a72a4e8c12f2359
ARG UV_VERSION=0.8.11
ARG CONTROLLER_REVISION=unknown
ARG CONTROLLER_PR_HEAD_REVISION=unknown
LABEL org.opencontainers.image.source="https://github.com/konveyor/agentic-controller" \
    org.opencontainers.image.revision="${CONTROLLER_REVISION}" \
    io.konveyor.controller.pr-head-revision="${CONTROLLER_PR_HEAD_REVISION}" \
    io.konveyor.lightspeed.source="${LIGHTSPEED_REPOSITORY}" \
    io.konveyor.lightspeed.revision="${LIGHTSPEED_REVISION}"

WORKDIR /opt/lightspeed
RUN git init . \
    && git remote add origin "${LIGHTSPEED_REPOSITORY}" \
    && git fetch --depth=1 origin "${LIGHTSPEED_REVISION}" \
    && git checkout --detach FETCH_HEAD \
    && test "$(git rev-parse HEAD)" = "${LIGHTSPEED_REVISION}" \
    && python3 -m venv /opt/uv \
    && /opt/uv/bin/pip install --no-cache-dir "uv==${UV_VERSION}" \
    && UV_PYTHON_DOWNLOADS=never /opt/uv/bin/uv sync --frozen --no-dev \
        --extra openai --extra acp --python /usr/bin/python3 --no-cache \
    && rm -rf /opt/uv /opt/lightspeed/.git

ENV PATH="/opt/lightspeed/.venv/bin:${PATH}" \
    HARNESS_RUNTIME=lightspeed

ENV PATH="/opt/migration-harness/bin:${PATH}"
ENV HARNESS_WORK_DIR=/workspace/repo
# OpenShift runs containers as a random UID with no passwd entry, which
# leaves HOME=/. Pin HOME to the harness home, which is group-0 writable
# (g=u), for runtime state and caches.
ENV HOME=/home/harness

COPY --from=builder /migration-harness /opt/migration-harness/bin/migration-harness

RUN mkdir -p /opt/skills /workspace /home/harness/.migration-harness \
    && useradd -u 1001 -g 0 -d /home/harness -s /sbin/nologin harness \
    && chown -R 1001:0 /home/harness /workspace \
    && chmod -R g=u /home/harness /workspace

WORKDIR /workspace
USER 1001

# Every native CI build checks the installed ACP bridge and all provider routes.
# Imports require no model credentials or network access.
RUN python3 -c 'import importlib, sys; assert sys.version_info >= (3, 12); [importlib.import_module(name) for name in ("lightspeed_agentic.acp.official", "lightspeed_agentic.providers.model_router", "lightspeed_agentic.providers.models.openai", "lightspeed_agentic.providers.models.anthropic", "lightspeed_agentic.providers.models.gemini", "langchain_aws", "langchain_google_vertexai")]'

ENTRYPOINT ["migration-harness"]
CMD ["run"]
