# E2E-only agent image. The production agent image remains unchanged; this
# image adds a deterministic lifecycle hook for workflow tests.

ARG BASE_IMAGE=quay.io/konveyor/agentic-controller-agent:e2e
FROM ${BASE_IMAGE}

COPY entrypoint.sh /usr/local/bin/e2e-agent-stub-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/e2e-agent-stub-entrypoint.sh"]
